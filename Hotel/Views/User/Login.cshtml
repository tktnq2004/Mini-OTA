@model Hotel.Models.User
@{
    ViewBag.Title = "Login";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2 class="text-center mb-4"></h2>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h4 class="mb-4 text-center">Sign In</h4>

                    @using (Html.BeginForm())
                    {
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label for="username" class="form-label">User Name</label>
                            <input type="text" id="username" name="username" class="form-control" placeholder="Enter your username" required>
                        </div>

                        <div class="mb-3">
                            <label for="password" class="form-label">Password</label>
                            <input type="password" id="password" name="password" class="form-control" placeholder="Enter your password" required>
                        </div>

                        <button type="submit" class="btn btn-dark w-100 mb-3">Login</button>
                    }

                    <a href="/User/ExternalLogin?provider=Google&returnUrl=/Hotel/HotelIndex" class="btn btn-outline-danger w-100 mb-3">
                        <img src="/Content/images/logo/gglogo.png" alt="Google Icon" style="height:20px; vertical-align:middle; margin-right:8px;">
                        Đăng nhập với Google
                    </a>

                    <div class="mt-4 text-center">
                        @Html.ActionLink(
                            "← Back to List",
                            "HotelIndex",
                            "Hotel",
                            null,
                            new { @class = "btn btn-outline-secondary" }
                        )
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .setting {
        margin-left: 8%;
    }
</style>
