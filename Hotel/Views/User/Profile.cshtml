@model Hotel.Models.User

@{
    ViewBag.Title = "Profile";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2 style="text-align:center">Profile</h2>
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h4 class="mb-4 text-center">Update Profile</h4>

                    @using (Html.BeginForm())
                    {
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label for="fullname" class="form-label">Customer Name</label>
                            <input type="text" id="fullname" name="fullname" value="@Model.FullName" class="form-control" placeholder="Enter your full name" required />
                        </div>

                        <div class="mb-3">
                            <label for="username" class="form-label">Username</label>
                            <input type="text" id="username" name="username" value="@Model.Username" class="form-control" placeholder="Your username" required />
                        </div>

                        <div class="mb-3">
                            <label for="email" class="form-label">Email</label>
                            <input type="email" id="email" name="email" value="@Model.Email" class="form-control" placeholder="Your email address" required />
                        </div>

                        <div class="mb-3">
                            <label for="numberphone" class="form-label">Phone Number</label>
                            <input type="tel" id="numberphone" name="numberphone" value="@Model.Phone" class="form-control" placeholder="Your phone number" required />
                        </div>

                        <!-- Toggle buttons -->
                        <div class="mb-3">
                            <button type="button" class="btn btn-outline-secondary" id="togglePasswordFields">
                                Change Password
                            </button>
                            <button type="button" class="btn btn-outline-danger ms-2" id="cancelPasswordFields" style="display: none;">
                                Cancel
                            </button>
                        </div>

                        <!-- Hidden password fields -->
                        <div class="mb-3 password-group" style="display: none;">
                            <label for="password" class="form-label">New Password</label>
                            <input type="password" id="password" name="password" class="form-control" placeholder="Enter new password" />
                        </div>

                        <div class="mb-3 password-group" style="display: none;">
                            <label for="changepassword" class="form-label">Confirm New Password</label>
                            <input type="password" id="changepassword" name="changepassword" class="form-control" placeholder="Confirm new password" />
                        </div>

                        <!-- Validation messages -->
                        <div class="text-danger mb-3">
                            @ViewData["enterpassword"] @ViewData["samepassword"]
                        </div>

                        <button type="submit" class="btn btn-dark w-100">Save Changes</button>
                    }
                </div>
            </div>

            <div class="mt-4 text-center">
                @Html.ActionLink(
                    "← Back to List",
                    "HotelIndex",
                    "Hotel",
                    null,
                    new { @class = "btn btn-outline-secondary" }
                )
            </div>
        </div>
    </div>
</div>

<script>
    // Lấy ra các phần tử nút và nhóm trường mật khẩu
    const toggleBtn = document.getElementById('togglePasswordFields'); // Nút "Change Password"
    const cancelBtn = document.getElementById('cancelPasswordFields'); // Nút "Cancel"
    const passwordGroups = document.querySelectorAll('.password-group'); // Tất cả các khối nhập mật khẩu

    // Khi click nút "Change Password"
    toggleBtn.addEventListener('click', () => {
        // Hiện các trường mật khẩu (New Password & Confirm Password)
        passwordGroups.forEach(group => group.style.display = 'block');

        // Ẩn nút "Change Password"
        toggleBtn.style.display = 'none';

        // Hiện nút "Cancel"
        cancelBtn.style.display = 'inline-block';
    });

    // Khi click nút "Cancel"
    cancelBtn.addEventListener('click', () => {
        // Ẩn các trường mật khẩu
        passwordGroups.forEach(group => group.style.display = 'none');

        // Hiện lại nút "Change Password"
        toggleBtn.style.display = 'inline-block';

        // Ẩn nút "Cancel"
        cancelBtn.style.display = 'none';

        // Xóa giá trị trong các ô nhập mật khẩu (phòng lỗi lưu giá trị)
        document.getElementById('password').value = '';
        document.getElementById('changepassword').value = '';
    });
</script>
