@model Hotel.Models.User

@{
    ViewBag.Title = "Profile";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2 style="text-align:center">Profile</h2>
<div class="setting">
    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()

        <div class="form-horizontal align-middle">
            <hr />
            <div class="form-group">
                <label class="control-label col-md-2">Customer Name</label>
                <div class="col-md-10">
                    <input type="text" name="fullname" value="@Model.FullName" class="form-control" />
                </div>
            </div>

            <div class="form-group">
                <label class="control-label col-md-2">Username</label>
                <div class="col-md-10">
                    <input type="text" name="username" value="@Model.Username" class="form-control" />
                </div>
            </div>

            <div class="form-group">
                <label class="control-label col-md-2">Email</label>
                <div class="col-md-10">
                    <input type="email" name="email" value="@Model.Email" class="form-control" />
                </div>
            </div>


            <div class="form-group">
                <label class="control-label col-md-2">Phone Number</label>
                <div class="col-md-10">
                    <input type="tel" name="numberphone" value="@Model.Phone" class="form-control" />
                </div>
            </div>

            <div class="form-group" id="passwordGroup" style="display:none">
                <label class="control-label col-md-2">Password</label>
                <div class="col-md-10">
                    <input type="password" id="password" name="password" class="form-control" disabled />
                </div>
            </div>

            <div class="form-group" id="confirmPasswordGroup" style="display: none">
                <label class="control-label col-md-2">ConfirmPassword</label>
                <div class="col-md-10">
                    <input type="password" id="changepassword" name="changepassword" class="form-control" disabled />
                </div>
            </div>

            <!-- Nút "Change Password" -->


            <button type="button" id="changePasswordBtn" class="btn btn-primary">Change Password</button>

            <!-- Nút "Cancel" (ẩn ban đầu) -->
            <button type="button" id="cancelBtn" class="btn btn-secondary" style="display: none;">Cancel</button>
            @ViewData["enterpassword"] @ViewData["samepassword"]

            <div class="form-group mt-5">
                <div class="col-md-offset-2 col-md-10">
                    <input type="submit" value="Save" class="btn btn-default" />
                </div>
            </div>
        </div>
    }

    <div>
        @Html.ActionLink("Back to List", "HotelIndex", "Hotel")
    </div>
</div>
<script>
    document.getElementById("changePasswordBtn").addEventListener("click", function () {
        document.getElementById("passwordGroup").style.display = "block"; // Hiện ô Password
        document.getElementById("confirmPasswordGroup").style.display = "block"; // Hiện ô Confirm Password

        // Bật lại input (sửa lỗi ở đây)
        document.getElementById("password").disabled = false;
        document.getElementById("changepassword").disabled = false;

        document.getElementById("changePasswordBtn").style.display = "none"; // Ẩn nút "Change Password"
        document.getElementById("cancelBtn").style.display = "inline-block"; // Hiện nút "Cancel"
    });

    document.getElementById("cancelBtn").addEventListener("click", function () {
        document.getElementById("passwordGroup").style.display = "none"; // Ẩn ô Password
        document.getElementById("confirmPasswordGroup").style.display = "none"; // Ẩn ô Confirm Password

        // Vô hiệu hóa input (sửa lỗi ở đây)
        document.getElementById("password").disabled = true;
        document.getElementById("changepassword").disabled = true;

        document.getElementById("changePasswordBtn").style.display = "inline-block"; // Hiện lại nút "Change Password"
        document.getElementById("cancelBtn").style.display = "none"; // Ẩn nút "Cancel"
    });

</script>
<style>
    .setting {
        margin-left: 8%;
    }
</style>