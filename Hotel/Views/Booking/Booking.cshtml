@model Hotel.Models.Booking

@{
    ViewBag.Title = "Booking";
    var soDem = (Model.CheckOut - Model.CheckIn).Days;
    var giaGoc = Model.Amount / soDem / (1 - Model.Discount / 100m);
    var giaSauGiam = Model.Amount / soDem;
    var countdownSeconds = (Model.ExpirationTime - DateTime.Now).TotalSeconds;
}

<div class="container mt-4 p-4 border rounded shadow">
    <h2 class="mb-3 text-primary">Đặt phòng thành công!</h2>

    <div class="row">
        <div class="col-md-6">
            <h4>Thông tin đặt phòng</h4>
            <ul class="list-group">
                <li class="list-group-item"><strong>Phòng:</strong> @Model.Room.RoomName</li>
                <li class="list-group-item"><strong>Mô tả:</strong> @Model.Room.Description</li>
                <li class="list-group-item"><strong>Ngày nhận phòng:</strong> @Model.CheckIn.ToString("dd/MM/yyyy")</li>
                <li class="list-group-item"><strong>Ngày trả phòng:</strong> @Model.CheckOut.ToString("dd/MM/yyyy")</li>
                <li class="list-group-item"><strong>Số đêm:</strong> @soDem</li>
                <li class="list-group-item"><strong>Giá mỗi đêm:</strong> @giaGoc.ToString("C0", System.Globalization.CultureInfo.GetCultureInfo("vi-VN"))</li>
                <li class="list-group-item"><strong>Giảm giá:</strong> @Model.Discount%</li>
                <li class="list-group-item text-success"><strong>Giá sau giảm:</strong> @giaSauGiam.ToString("C0", System.Globalization.CultureInfo.GetCultureInfo("vi-VN"))</li>
                <li class="list-group-item"><strong>Tổng tiền:</strong> @Model.Amount.ToString("C0", System.Globalization.CultureInfo.GetCultureInfo("vi-VN"))</li>
                <li class="list-group-item">
                    <strong>Trạng thái thanh toán:</strong>
                    <span class="text-warning">@Model.PaymentStatus</span>
                </li>
            </ul>
        </div>

        <div class="col-md-6">
            <h4>Thời gian giữ phòng</h4>
            <div class="alert alert-info">
                Vui lòng thanh toán trong vòng <span id="timer"></span> để giữ phòng.
            </div>

            <script>
                let countdown = @Math.Floor(countdownSeconds);

                function updateTimer() {
                    if (countdown <= 0) {
                        document.getElementById("timer").innerText = "Hết thời gian giữ phòng!";
                        return;
                    }

                    let minutes = Math.floor(countdown / 60);
                    let seconds = countdown % 60;
                    document.getElementById("timer").innerText = minutes + " phút " + seconds + " giây";

                    countdown--;
                    setTimeout(updateTimer, 1000);
                }

                updateTimer();
            </script>
        </div>
    </div>

    <div class="mt-4 text-end">
        <a href="@Url.Action("Index", "Home")" class="btn btn-secondary">Quay về trang chủ</a>
        <a href="@Url.Action("History", "Booking")" class="btn btn-success">Xem lịch sử đặt phòng</a>
    </div>
</div>
