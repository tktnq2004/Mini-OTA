@model string
@{
    ViewBag.Title = "Bank Transfer";
    string accountName = "Trần Khương Trung Nhật Quang";
    string accountNumber = "00696919112004";
    string bankName = "Ngân hàng quân đội MB Bank - CN Cát Lái";
    string transferContent = "Thanh toán hóa đơn #" + ViewBag.BookingID;
    decimal amount = ViewBag.Amount ?? 0;
}

<div class="card shadow-sm p-3">
    <div class="row">
        <div class="col-md-5 text-center">
            <img src="@Model" alt="QR Banking" class="img-fluid rounded border" style="max-width: 250px;" />
            <p class="mt-2 text-muted">Quét mã QR bằng ứng dụng ngân hàng</p>
        </div>
        <div class="col-md-7">
            <h5 class="mb-3 text-primary"><i class="bi bi-bank2"></i> Thông tin chuyển khoản</h5>
            <ul class="list-group list-group-flush">
                <li class="list-group-item">
                    <strong>Ngân hàng:</strong> @bankName
                </li>
                <li class="list-group-item">
                    <strong>Số tài khoản:</strong> @accountNumber
                </li>
                <li class="list-group-item">
                    <strong>Chủ tài khoản:</strong> @accountName
                </li>
                <li class="list-group-item">
                    <strong>Số tiền:</strong> <span class="text-success fw-bold">@String.Format("{0:N0}", amount) VND</span>
                </li>
                <li class="list-group-item">
                    <strong>Nội dung chuyển khoản:</strong>
                    <span class="text-danger">@transferContent</span>
                </li>
            </ul>
            <div class="alert alert-warning mt-3 mb-0 small">
                <i class="bi bi-info-circle-fill"></i> Vui lòng chuyển khoản đúng nội dung để hệ thống xác nhận tự động.
            </div>
        </div>
    </div>
</div>
