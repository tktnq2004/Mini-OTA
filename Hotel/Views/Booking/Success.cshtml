@{
    ViewBag.Title = "Thanh toán thành công";
    Layout = "~/Views/Shared/_Layout.cshtml"; // hoặc Layout của bạn
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg border-success">
                <div class="card-body text-center">
                    <div class="mb-4">
                        <i class="bi bi-check-circle-fill text-success" style="font-size: 4rem;"></i>
                    </div>
                    <h2 class="text-success mb-3">Thanh toán thành công!</h2>
                    <p class="lead">Cảm ơn bạn đã đặt phòng tại hệ thống của chúng tôi.</p>
                    <p>Chúng tôi đã nhận được thanh toán của bạn. Vui lòng kiểm tra email để xem chi tiết đơn đặt phòng.</p>
                    <a href="@Url.Action("HotelIndex","Hotel")" class="btn btn-outline-success mt-4">
                        <i class="bi bi-house-door"></i> Về trang chủ
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

