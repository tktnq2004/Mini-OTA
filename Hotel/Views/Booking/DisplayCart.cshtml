@model IEnumerable<Hotel.Models.CartDisplay>
@{
    ViewBag.Title = "DisplayCart";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@using (Html.BeginForm("Booking", "Booking", FormMethod.Post, new { id = "bookingForm" }))
{
    <div class="container2 mt-4">
        <div class="row row-cols-1 row-cols-md-2 g-4">
            <!-- Thêm row-cols để hiển thị 2 phòng trên mỗi hàng -->
            @foreach (var item in Model)
            {
                <div class="col">
                    <!-- Mỗi phòng sẽ nằm trong một thẻ col -->
                    <div class="row border rounded p-3 mb-4 shadow-sm">
                        <!-- Cột trái: Checkbox -->
                        <div class="col-md-1 d-flex align-items-center justify-content-center">
                            <input type="checkbox" name="roomIds" value="@item.RoomID" class="room-checkbox">
                        </div>

                        <!-- Cột giữa: Hình ảnh -->
                        <div class="col-md-5">
                            <img src="@item.RoomImages.FirstOrDefault().ImageURL"
                                 class="img-fluid border rounded" style="max-height: 300px; object-fit: cover;">
                        </div>

                        <!-- Cột phải: Thông tin phòng -->
                        <div class="col-md-6">
                            <h4 class="font-weight-bold">@item.RoomName</h4>
                            <p>
                                <strong>Price: </strong>
                                @if (item.Percent > 0)
                                {
                                    <del class="old-price">@item.Price.ToString("N0") VND</del>
                                    <span class="text-danger"> @((item.Price - (item.Price * ((decimal)item.Percent / 100m))).ToString("N0")) VND</span>

                                }
                                else
                                {
                                    <span>@item.Price.ToString("N0") VND</span>
                                }
                                / night
                            </p>
                            <p><strong>Capacity:</strong> @item.Capacity @(item.Capacity > 1 ? "people" : "person")</p>
                            <p><strong>Description:</strong> @item.Description</p>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Nút xác nhận đặt phòng -->
    <div class="fixed-bottom-bar p-3 bg-white shadow float-end">
        <form method="post" action="/Booking/Confirm">
            <button type="submit" name="action" value="discard" class="btn btn-danger btn-lg">Discard</button>
            <button type="submit" name="action" value="confirm" class="btn btn-primary btn-lg">Confirm Booking</button>
        </form>
    </div>

}

<style>

    .row {
        transition: transform 0.2s ease-in-out;
    }

        .row:hover {
            transform: translateY(-5px);
        }

    .fixed-bottom-bar {
        position: fixed;
        bottom: 0;
        left: 0;
        width: 100%;
        background: linear-gradient(to right, #f9c5d1, #fef4f4); /* Giống navbar */
        border-top: 2px solid #f8a5c2; /* Viền trên cùng màu navbar */
        padding: 15px;
        text-align: end;
        z-index: 1000;
        transition: all 0.3s ease-in-out;
    }

        /* Nút bấm đồng bộ phong cách */
        .fixed-bottom-bar button {
            background-color: #d63384; /* Màu chủ đạo */
            color: white;
            font-size: 18px;
            font-weight: bold;
            padding: 12px 24px;
            border: none;
            border-radius: 25px;
            cursor: pointer;
            transition: all 0.3s ease-in-out;
        }

            .fixed-bottom-bar button:hover {
                background-color: #ff69b4; /* Hiệu ứng hover */
                transform: scale(1.05);
            }

    .room-checkbox {
        appearance: none; /* Ẩn checkbox mặc định */
        width: 25px;
        height: 25px;
        border: 2px solid #ff4b2b; /* Màu viền giống booking-btn */
        border-radius: 5px;
        background-color: white;
        cursor: pointer;
        transition: all 0.3s ease-in-out;
        position: relative;
    }

        /* Khi được chọn */
        .room-checkbox:checked {
            background-color: #ff4b2b; /* Màu nền giống booking-btn */
            border-color: #ff4b2b;
        }

            /* Thêm dấu check khi chọn */
            .room-checkbox:checked::after {
                content: "✔";
                font-size: 16px;
                font-weight: bold;
                color: white;
                position: absolute;
                top: 50%;
                left: 50%;
                transform: translate(-50%, -50%);
            }

        /* Hiệu ứng hover */
        .room-checkbox:hover {
            transform: scale(1.1);
            border-color: #ff416c;
        }
    }
</style>