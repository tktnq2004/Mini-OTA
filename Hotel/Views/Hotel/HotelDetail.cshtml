@model dynamic
@{
    var current = Session["CurrentHotel"] as Hotel.Models.HotelModel.HotelModel;
    var others = Session["OtherHotels"] as List<Hotel.Models.HotelModel.HotelModel>;
}
<div class="input-group mb-3">
    <input type="text" id="searchHotelInput" class="form-control" placeholder="Search hotels..." autocomplete="off"/>
    <span class="input-group-text bg-primary text-white"><i class="bi bi-search"></i></span>
</div>

<div class="mb-4">
    @Html.Partial("CurrentHotel", current)
</div>

<hr />

<div id="otherHotelsContent">
    @Html.Partial("OtherHotel", others)
</div>

<script>
    $(document).ready(function () {
        $("#searchHotelInput").on("keyup", function () {
            let keyword = $(this).val().trim();

            $.ajax({
                url: "/Hotel/SearchHotel",
                type: "GET",
                data: { keyWord: keyword },
                success: function (html) {
                    $("#otherHotelsContent").html(html);
                },
                error: function () {
                    console.error("Search failed.");
                }
            });
        });
    });
</script>
