@model IEnumerable<Hotel.Models.HotelModel.HotelModel>

    @foreach (var hotel in Model)
    {
        <div class="card mb-2 shadow-sm border-0 hotel-card" data-hotel-id="@hotel.HotelID" style="cursor: pointer;">
            <div class="row g-0">
                <div class="col-4">
                    <img src="@hotel.HotelImage" class="img-fluid rounded-start hotel-image-fixed" />
                </div>
                <div class="col-8">
                    <div class="card-body py-2 px-2">
                        <h6 class="card-title text-primary mb-1">@hotel.HotelName</h6>
                        <p class="text-muted small mb-1">
                            <i class="bi bi-geo-alt-fill"></i> @hotel.Address
                        </p>
                        @if (hotel.Amenities?.Any() == true)
                        {
                            <div class="small text-muted mb-1">
                                <strong>Amenities:</strong>
                                <div class="d-flex flex-wrap gap-1 mt-1">
                                    @foreach (var a in hotel.Amenities.Take(3))
                                    {
                                        <span title="@a.AmenityName">
                                            <i class="bi @a.AmenityIcon"></i>
                                        </span>
                                    }
                                </div>
                            </div>
                        }
                        @if (hotel.Views?.Any() == true)
                        {
                            <div class="small text-muted">
                                <strong>View:</strong>
                                <div class="d-flex flex-wrap gap-1 mt-1">
                                    @foreach (var v in hotel.Views.Take(2))
                                    {
                                        <span title="@v.ViewName">
                                            <i class="bi @v.ViewIcon"></i>
                                        </span>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }

<style>
    .hotel-image-fixed {
        width: 100%;
        height: 140px;
        object-fit: cover;
        border-radius: 0.5rem 0 0 0.5rem;
    }
</style>