        </style>
        <div class="container" id="mymap" style="height: 600px; position: relative;">
            <!-- Modal mini nằm trong bản đồ -->
            <div id="hotelDetailModal">
                <div id="hotelDetailContent"></div>
            </div>

            <!-- Hộp reserve nằm bên phải -->
