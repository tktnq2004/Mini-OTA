@using Hotel.Models
@{
    User user = (User)Session["User"];
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="google" content="notranslate">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title</title>
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
    <link rel="stylesheet" href="/Content/Site.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <link href="https://unpkg.com/maplibre-gl@3.4.0/dist/maplibre-gl.css" rel="stylesheet" />
    <script src="https://unpkg.com/maplibre-gl@3.4.0/dist/maplibre-gl.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/pannellum@2.5.6/build/pannellum.css" />
    <script type="text/javascript" src="https://cdn.jsdelivr.net/npm/pannellum@2.5.6/build/pannellum.js"></script>
</head>
<body class="d-flex flex-column min-vh-100">

    <nav class="navbar navbar-expand-lg navbar-dark navbar-custom fixed-top">
        <div class="container">
            <a class="navbar-brand" href="/"> ZooZee </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto align-items-center">
                    <li class="nav-item">
                        @Html.ActionLink("Home", "MainMenu", "Menu", new { area = "" }, new { @class = "nav-link custom-hover" })
                    </li>
                    <li class="nav-item">
                        @Html.ActionLink("Destinations", "HotelIndex", "Hotel", new { area = "" }, new { @class = "nav-link custom-hover" })
                    </li>
                    <li class="nav-item">
                        @Html.ActionLink("AboutUs", "AboutUs", "Menu", new { area = "" }, new { @class = "nav-link custom-hover" })
                    </li>
                    <li class="nav-item">
                        @Html.ActionLink("Services", "Services", "Menu", new { area = "" }, new { @class = "nav-link custom-hover" })
                    </li>
                    @if (Session["User"] == null)
                    {
                        <li class="nav-item">
                            <a href="@Url.Action("Login", "User")" class="text-dark me-3">
                                <i class="fa fa-sign-in-alt"></i> Log in
                            </a>
                        </li>

                        <li class="nav-item">
                            <a href="@Url.Action("Register", "User")" class="text-dark">
                                <i class="fa fa-user-plus"></i> Register
                            </a>
                        </li>
                    }
                    else if (user.Role == "Customer")
                    {
                        <li class="nav-item">
                            @Html.ActionLink("Home", "HotelMain", "Hotel", new { area = "" }, new { @class = "nav-link custom-hover" })
                        </li>
                        <li class="nav-item">
                            @Html.ActionLink("Wish List", "DisplayWishlist", "Booking", new { area = "" }, new { @class = "nav-link custom-hover" })
                        </li>
                        <li class="nav-item">
                            @Html.ActionLink("Booked", "History", "Payment", new { area = "" }, new { @class = "nav-link custom-hover" })
                        </li>
                        <li class="nav-item">
                            <a href="@Url.Action("Profile", "User")" class="nav-link text-white">👤@(user.FullName) </a>
                        </li>
                        <li class="nav-item">
                            @Html.ActionLink("Logout", "Logout", "User", new { area = "" }, new { @class = "nav-link custom-hover text-danger" })
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            @Html.ActionLink("Room List", "Index", "Admin", new { area = "" }, new { @class = "nav-link custom-hover" })
                        </li>
                        <li class="nav-item">
                            @Html.ActionLink("Booking List", "BookingStatistic", "Admin", new { area = "" }, new { @class = "nav-link custom-hover" })
                        </li>
                        <li class="nav-item">
                            @Html.ActionLink("Discount List", "DiscountStatistic", "Admin", new { area = "" }, new { @class = "nav-link custom-hover" })
                        </li>
                        <li class="nav-item">
                            @Html.ActionLink("Logout", "Logout", "User", new { area = "" }, new { @class = "nav-link custom-hover text-danger" })
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <div class="body-content flex-grow-1" style="padding-top: 80px;">
        @RenderBody()
    </div>

    <footer class="footer-custom text-white py-5 mt-5" style="background-color: #333;">
        <div class="container">
            <div class="row">
                <!-- Logo + Awards -->
                <div class="col-md-4 mb-4 mb-md-0 text-center text-md-left">
                    <img src="/Content/images/logo/tripadvisor-badge.png" alt="TripAdvisor Award" class="mb-3" style="max-height: 120px;">
                    <br>
                    <img src="/Content/images/logo/hotel-award.png" alt="Hotel Award" style="max-height: 120px;">
                </div>

                <!-- Newsletter -->
                <div class="col-md-4 mb-4 mb-md-0 text-center">
                    <h5 class="mb-3" style="color: #d4af37;">Newsletter</h5>
                    <p>Newsletter for Exclusive Promotional deals ?</p>
                    <form>
                        <div class="form-group">
                            <input type="email" class="form-control mb-2" placeholder="Email">
                            <button type="submit" class="btn btn-warning btn-block">Sign up Now</button>
                        </div>
                    </form>
                    <div class="mt-3">
                        <img src="/Content/images/logo/visa.png" alt="Visa" style="height:40px; margin-right:5px;">
                        <img src="/Content/images/logo/mastercard.png" alt="Mastercard" style="height:40px; margin-right:5px;">
                        <img src="/Content/images/logo/amex.png" alt="Amex" style="height:40px; margin-right:5px;">
                        <img src="/Content/images/logo/paypal.png" alt="PayPal" style="height:40px;">
                    </div>
                </div>

                <!-- Contact Info -->
                <div class="col-md-4 text-center text-md-left">
                    <h5 class="mb-3" style="color: #d4af37;">CONTACT</h5>
                    <p><i class="fas fa-map-marker-alt mr-2"></i> 32A - 34 Bùi Thị Xuân, Quận 1, TP. Hồ Chí Minh, Vietnam</p>
                    <p><i class="fas fa-phone mr-2"></i> 0242 242 0777 - Hotline/Zalo: 09 1234 1900</p>
                    <p><i class="fas fa-fax mr-2"></i> 0242 242 0777</p>
                    <p><i class="fas fa-envelope mr-2"></i> info@webhotel.vn</p>
                    <!-- Mạng xã hội -->
                    <div class="mt-3">
                        <a href="https://www.facebook.com/quangcter" class="text-white mr-2"><i class="fab fa-facebook-f fa-lg"></i></a>
                        <a href="https://www.instagram.com/_wen.gg/" class="text-white mr-2"><i class="fab fa-instagram fa-lg"></i></a>
                        <a href="https://x.com/GenshinImpact" class="text-white mr-2"><i class="fab fa-twitter fa-lg"></i></a>
                        <a href="#" class="text-white mr-2"><i class="fab fa-google-plus-g fa-lg"></i></a>
                        <a href="https://youtu.be/SeWt7IpZ0CA?si=WVm94m8_iCpwX26g" class="text-white"><i class="fab fa-youtube fa-lg"></i></a>
                    </div>
                </div>
            </div>

            <hr class="my-4 border-light">
            <p class="text-center mb-0">&copy; @DateTime.Now.Year - Weng Hotel. All rights reserved.</p>
        </div>
    </footer>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
    @RenderSection("upload", required: false)

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            let navbar = document.querySelector(".navbar-custom");

            window.addEventListener("scroll", function () {
                if (window.scrollY > 40) {
                    navbar.classList.add("shrink");
                } else {
                    navbar.classList.remove("shrink");
                }
            });

            // Tắt autocomplete cho toàn bộ form
            document.querySelectorAll("form").forEach(function (form) {
                form.setAttribute("autocomplete", "off");
            });
            document.querySelectorAll("input").forEach(function (input) {
                input.setAttribute("autocomplete", "off");
            });
        });
    </script>

</body>
</html>