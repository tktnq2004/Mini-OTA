                        <option>1 Room, 1 Adult, 0 Children</option>
                    </select>
                </div>
                <button>HOTEL SEARCH</button>
            </div>
        </div>
        <script>
            var initialLatLng = [10.762622, 106.660172];
            var initialZoom = 8;

            var map = L.map('mymap').setView(initialLatLng, initialZoom);

            L.tileLayer('https://{s}.basemaps.cartocdn.com/light_nolabels/{z}/{x}/{y}{r}.png', {
                attribution: '&copy; CARTO'
            }).addTo(map);
            map.attributionControl.setPrefix(false); map.scrollWheelZoom.disable(); map.doubleClickZoom.disable();

            var ResetViewControl = L.Control.extend({
                options: {
                    position: 'topleft'  // Nằm cùng vị trí với zoom control mặc định
                },

                onAdd: function (map) {
                    var container = L.DomUtil.create('div', 'leaflet-bar leaflet-control leaflet-control-custom');

                    container.style.backgroundColor = 'white';
                    container.style.width = '30px';
                    container.style.height = '30px';
                    container.style.cursor = 'pointer';
                    container.style.textAlign = 'center';
                    container.style.lineHeight = '30px';
                    container.style.fontSize = '18px';
                    container.title = "Reset View";
                    container.innerHTML = '<i class="bi bi-cursor"></i>'; 

                    container.onclick = function () {
                        map.setView(initialLatLng, initialZoom);
                    }

                    L.DomEvent.disableClickPropagation(container);
                    L.DomEvent.disableScrollPropagation(container);

                    return container;
                }
            }); map.addControl(new ResetViewControl());

            // Gọi dữ liệu từ controller
            let hotelsData = [];

            fetch('/Hotel/GetAllHotels')
                .then(r => r.json())
                .then(data => {
                    hotelsData = data;
                    const dropdownMenu = document.getElementById('dropdownHotelMenu');
                    const dropdownBtn = document.getElementById('dropdownHotelBtn');

                    const hotelMarkers = {};
                    data.forEach(hotel => {
                        // Tạo dropdown item
                        const li = document.createElement('li');
                        const a = document.createElement('a');
                        a.classList.add('dropdown-item');
                        a.href = "#";
                        a.textContent = hotel.HotelName;
                        a.dataset.hotelId = hotel.HotelID;
                        li.appendChild(a);
                        dropdownMenu.appendChild(li);

                        // Tạo marker và lưu vào object
                        const marker = L.marker([hotel.Latitude, hotel.Longitude]).addTo(map);
                        hotelMarkers[hotel.HotelID] = marker;

                        marker.on('click', () => {
                            dropdownBtn.textContent = hotel.HotelName;
                            map.setView([hotel.Latitude, hotel.Longitude], 10);

                            $.get("/Hotel/GetHotelDetail", { hotelId: hotel.HotelID }, html => {
                                $("#hotelDetailContent").html(html);
                                $("#hotelDetailModal").fadeIn();
                            });
                        });
                    });

                    // Bắt sự kiện click trên dropdown item
                    dropdownMenu.addEventListener('click', function (e) {
                        if (e.target && e.target.matches('.dropdown-item')) {
                            e.preventDefault();
                            const hotelId = parseInt(e.target.dataset.hotelId);
                            const marker = hotelMarkers[hotelId];
                            if (marker) {
                                marker.fire('click');  // Gọi lại sự kiện click marker tương ứng
                            }
                        }
                    });
                });

            // Ẩn modal khi click ngoài modal hoặc marker và dropdown
            $(document).on("click", function (e) {
                if (
                    !$(e.target).closest("#hotelDetailModal, .leaflet-marker-icon, #dropdownHotelBtn, #dropdownHotelMenu").length
                ) {
                    $("#hotelDetailModal").fadeOut();

                    const currentCenter = map.getCenter();
                    map.setView(currentCenter, 8);
                }
            });

            // Nút reset view luôn hiển thị, không ẩn đi
            $("#resetViewBtn").on('click', function () {
                map.setView(initialLatLng, initialZoom);
            });
        </script>
        <style>
