<script>
    document.addEventListener("DOMContentLoaded", function () {
        let navbar = document.querySelector(".navbar-custom");

        window.addEventListener("scroll", function () {
            if (window.scrollY > 40) { // Nếu cuộn xuống hơn 50px
                navbar.classList.add("shrink");
            } else {
                navbar.classList.remove("shrink");
            }
        });
    });
        document.addEventListener("DOMContentLoaded", function () {

            let datePicker = flatpickr("#dateRange", {
            mode: "range",
        dateFormat: "d-m-Y",
        minDate: "today",
        closeOnSelect: false, // Giữ lịch mở khi chọn ngày
        onChange: function (selectedDates, dateStr, instance) {
            let currentMonth = instance.currentMonth; // Lưu tháng hiện tại
        let currentYear = instance.currentYear;   // Lưu năm hiện tại

        if (selectedDates.length === 1) {
            highlightSelectedDate(selectedDates[0], "#007bff", "white");
            } else if (selectedDates.length === 2) {
            let checkIn = selectedDates[0];
        let checkOut = selectedDates[1];

        if (checkIn.getTime() === checkOut.getTime()) {
            instance.clear();
        instance.jumpToDate(new Date(currentYear, currentMonth)); // Mở lại đúng tháng trước đó
                } else {
            highlightSelectedDate(checkOut, "#ffc107", "black"); // Check-out màu vàng
        instance.close();
                }
            }
        }
    });

        function highlightSelectedDate(date, bgColor, textColor) {
            document.querySelectorAll(".flatpickr-day").forEach(day => {
                if (day.dateObj && day.dateObj.getTime() === date.getTime()) {
                    day.style.backgroundColor = bgColor;
                    day.style.color = textColor;
                }
            });
    }
});

</script>
    <!-- Bootstrap JavaScript (phải có để dropdown hoạt động) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

