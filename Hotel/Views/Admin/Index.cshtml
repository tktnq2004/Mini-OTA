@model IEnumerable<Hotel.Models.Room>
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">Room List</h2>
        <a href="@Url.Action("Add", "Admin")" class="btn btn-primary">
            <i class="fas fa-plus"></i> Add Room
        </a>
    </div>

    <div class="card mb-4">
        <div class="card-header bg-light">
            <strong>Filter by Room Type</strong>
        </div>
        <div class="card-body">
            <select class="form-select w-auto" id="roomTypeSelect">
                <option value="">-- All Room Types --</option>
                @foreach (var type in ViewBag.RoomTypes)
                {
                    <option value="@type.RoomTypeId">@type.RoomTypeName</option>
                }
            </select>
        </div>
    </div>

    <div class="card">
        <div class="card-body p-0">
            <table class="table table-striped table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Room Name</th>
                        <th>Room Type</th>
                        <th>Price</th>
                        <th>Capacity</th>
                        <th class="text-center">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var room in Model)
                    {
                        <tr>
                            <td>@room.RoomName</td>
                            <td>@room.RoomType.RoomTypeName</td>
                            <td>@room.Price.ToString("N0")</td>
                            <td>@room.Capacity</td>
                            <td class="text-center">
                                <a href="@Url.Action("Update", "Admin", new { id = room.RoomID })" class="btn btn-sm btn-warning me-1">
                                    <i class="fas fa-edit"></i> Update
                                </a>
                                <form action="@Url.Action("Delete", "Admin")" method="post" style="display:inline;">
                                    <input type="hidden" name="id" value="@room.RoomID" />
                                    <button type="submit" class="btn btn-sm btn-danger me-1" onclick="return confirm('Delete this room?');">
                                        <i class="fas fa-trash"></i> Delete
                                    </button>
                                </form>
                                <a href="@Url.Action("Images", "Admin", new { id = room.RoomID })" class="btn btn-sm btn-info">
                                    <i class="fas fa-image"></i> Images
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById("roomTypeSelect").addEventListener("change", function () {
            var roomTypeId = this.value;
            var url = '/Admin/ListRoom';
            if (roomTypeId) {
                window.location.href = url + '?roomTypeId=' + roomTypeId;
            } else {
                window.location.href = url;
            }
        });
    </script>
}
