@model List<Hotel.Models.DiscountView>
@{
    ViewBag.Title = "DiscountStatistic";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container my-5">
    <h2 class="text-center mb-4">Quản Lý Discount</h2>

    <!-- Bộ lọc theo ngày -->
    <div class="card mb-4">
        <div class="card-header bg-primary text-white">
            <strong>Bộ lọc theo ngày</strong>
        </div>
        <div class="card-body">
            <form method="get" action="@Url.Action("DiscountStatistic", "Admin")" class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label class="form-label">Từ ngày:</label>
                    <input type="date" name="startDate" value="@ViewBag.StartDate" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Đến ngày:</label>
                    <input type="date" name="endDate" value="@ViewBag.EndDate" class="form-control" />
                </div>
                <div class="col-md-4">
                    <button type="submit" class="btn btn-primary w-100">Lọc</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Form thêm Discount -->
    <div class="card mb-4">
        <div class="card-header bg-success text-white">
            <strong>Thêm Discount</strong>
        </div>
        <div class="card-body">
            <form method="post" action="@Url.Action("AddDiscount", "Discount")" class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Phần trăm giảm giá:</label>
                    <input type="number" name="DiscountPercent" min="0" max="100" class="form-control" required />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Ngày bắt đầu:</label>
                    <input type="date" name="StartDate" class="form-control" required />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Ngày kết thúc:</label>
                    <input type="date" name="EndDate" class="form-control" required />
                </div>
                <div class="col-12">
                    <button type="submit" class="btn btn-success w-100">Thêm Discount</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Danh sách Discount -->
    <div class="card">
        <div class="card-header bg-dark text-white">
            <strong>Danh sách Discount</strong>
        </div>
        <div class="card-body p-0">
            <table class="table table-hover table-striped mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Phần trăm</th>
                        <th>Ngày bắt đầu</th>
                        <th>Ngày kết thúc</th>
                        <th>Phòng</th>
                        <th>Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var discount in Model)
                    {
                        <tr>
                            <td>@discount.DiscountID</td>
                            <td style="width: 150px;">
                                <select class="form-select" onchange="updateDiscountPercent(@discount.DiscountID, this.value)">
                                    @for (int i = 0; i <= 100; i += 5)
                                    {
                                        <option value="@i" @(discount.DiscountPercent == i ? "selected" : "")>@i%</option>
                                    }
                                </select>
                            </td>
                            <td>@discount.StartDate:dd/MM/yyyy</td>
                            <td>@discount.EndDate:dd/MM/yyyy</td>
                            <td style="max-width: 250px;">
                                @if (discount.Rooms.Any())
                                {
                                    <ul class="list-unstyled mb-0">
                                        @foreach (var room in discount.Rooms)
                                        {
                                            <li id="room-@discount.DiscountID-@room.RoomID" class="mb-1">
                                                <span class="badge bg-secondary">@room.RoomName</span>
                                                <button type="button"
                                                        class="btn btn-sm btn-danger ms-2 btn-remove"
                                                        data-discountid="@discount.DiscountID"
                                                        data-roomid="@room.RoomID">
                                                    x
                                                </button>
                                            </li>
                                        }
                                    </ul>
                                }
                                else
                                {
                                    <span class="text-muted fst-italic">Chưa có phòng</span>
                                }
                            </td>
                            <td style="width: 200px;">
                                <a href="@Url.Action("DeleteDiscount", "Discount", new { id = discount.DiscountID })"
                                   class="btn btn-sm btn-danger mb-2 w-100"
                                   onclick="return confirm('Bạn có chắc muốn xóa discount này?');">
                                    🗑 Xóa
                                </a>

                                <form method="post" action="@Url.Action("AddRoomToDiscount", "Admin")" class="d-flex">
                                    <input type="hidden" name="discountId" value="@discount.DiscountID" />
                                    <select name="roomId" class="form-select me-2">
                                        @foreach (var room in ViewBag.Rooms)
                                        {
                                            <option value="@room.RoomID">@room.RoomName</option>
                                        }
                                    </select>
                                    <button type="submit" class="btn btn-sm btn-info">+</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $("form").submit(function (e) {
            if ($(this).attr("method") === "post" && !$(this).attr("action").includes("DiscountStatistic")) {
                e.preventDefault();
                var form = $(this);
                $.post(form.attr("action"), form.serialize(), function (data) {
                    if (data.success) {
                        location.reload();
                    }
                }).fail(function () {
                    alert("Có lỗi xảy ra!");
                });
            }
        });

        $(".btn-remove").click(function () {
            var button = $(this);
            var discountId = button.data("discountid");
            var roomId = button.data("roomid");

            if (confirm("Bạn có chắc muốn xóa phòng này khỏi Discount?")) {
                $.ajax({
                    url: "@Url.Action("RemoveRoomFromDiscount", "Admin")",
                    type: "POST",
                    data: { discountId: discountId, roomId: roomId },
                    success: function (data) {
                        if (data.success) {
                            $("#room-" + discountId + "-" + roomId).remove();
                        } else {
                            alert("Không tìm thấy phòng trong chương trình giảm giá!");
                        }
                    },
                    error: function () {
                        alert("Có lỗi xảy ra!");
                    }
                });
            }
        });

        function updateDiscountPercent(discountId, percent) {
            $.post('@Url.Action("UpdateDiscountPercent", "Admin")',
                { discountId: discountId, percent: percent },
                function (data) {
                    if (!data.success) {
                        alert("Cập nhật thất bại!");
                    }
                }).fail(function () {
                    alert("Có lỗi xảy ra!");
                });
        }
    </script>
}