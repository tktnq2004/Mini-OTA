    <div class="col-lg-4 col-md-4 col-sm-6 col-xs-12">
        <div class="card border-0">
            <div class="card-header bg-transparent text-black ">
                <p><strong>[SRING PROMOTION 2025] COMBO NGHỈ DƯỠNG 2N1Đ</strong></p>
            </div>
            <div class="card-body bg-transparent text-black">
                <img src="~/Content/images/KM_2.jpg" width="375" height="200" />
            </div>
            <div class="card-footer bg-transparent">
                <p>Thời gian: 28/02/2025 - 30/04/2025</p>
            </div>
