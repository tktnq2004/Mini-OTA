<!-- Khu vực hiển thị danh sách phòng -->
<div id="room-list">
</div>
<!-- Modal Hiển Thị Chi Tiết Phòng -->
<div class="modal fade" id="roomDetailModal" tabindex="-1" aria-labelledby="roomDetailModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="roomDetailModalLabel">Room Detail</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="roomDetailContent">
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Thêm Bootstrap JS nếu chưa có -->


<script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>

<script>
    // Script xử lý lọc theo loại phòng
    $(document).on("click", ".filter-btn[data-fil='type']", function () {
        var roomTypeId = $(this).data("value");
        filterRooms({ roomTypeId: roomTypeId, page: 1 });
    });

    // Script xử lý lọc theo giá (mặc định tăng dần)
    $(document).on("click", ".filter-btn[data-fil='price']", function () {
        filterRooms({ sortByPrice: "asc", page: 1 });
    });

    // Script xử lý lọc theo ngày nhận/trả phòng
    $(document).on("click", ".filter-btn[data-fil='date']", function () {
        var dateRange = $("#dateRange").val();
        filterRooms({ dateRange: dateRange, page: 1 });
    });

    // Hàm gọi AJAX để lấy dữ liệu lọc
    function filterRooms(filterData) {
        $.ajax({
            url: "/Room/FilterRooms",
            type: "GET",
            data: filterData,
            success: function (response) {
                $("#room-list").html(response); // Cập nhật danh sách phòng
            },
            error: function (xhr, status, error) {
                console.log("Lỗi AJAX:", xhr.responseText);
                alert("Lỗi: " + xhr.responseText); // Hiển thị lỗi chi tiết
            }
        });
    }


</script>
<script>
    $(document).ready(function () {
        $(document).on("click", ".room-img", function () {
            var roomid = $(this).data("roomid");

            $.get("/Room/GetRoomDetail", {roomid: roomid }, function (data) {
                $("#roomDetailContent").html(data); // Load Partial View vào modal
                $("#roomDetailModal").modal("show"); // Hiển thị modal
            });
        });
    });
</script>

<script>
    //lọc script
    $(document).ready(function () {
        $(".filter-btn").click(function (e) {
            e.preventDefault(); // Ngăn chặn load lại trang

            let filter = $(this).data("filter");

            // Ẩn khu vực khuyến mãi khi chọn filter khác
            $("#khuyenmai-section").hide();

            // Xóa class "selected" khỏi tất cả, rồi thêm vào phần tử được bấm
            $(".navbar-custom2 .nav-link").removeClass("selected");
            $(this).addClass("selected");
        });

        // Khi ấn vào "Khuyến mãi", hiển thị lại phần KHUYENMAI
        $(".filter-khuyenmai").click(function (e) {
            e.preventDefault();

            // Hiển thị lại phần khuyến mãi
            $("#khuyenmai-section").show();

            // Xóa class "selected" khỏi tất cả, rồi thêm vào Khuyến mãi
            $(".navbar-custom2 .nav-link").removeClass("selected");
            $(this).addClass("selected");

            // Xóa danh sách phòng
            $("#room-list").html("");
        });
    });
</script>
 <script>
    function filterRooms(filterData) {
        $.ajax({
            url: "/Room/FilterRooms",
            type: "GET",
            data: filterData,
            success: function (response) {
                $("#room-list").html(response); // Load lại danh sách phòng
                updatePaginationEvents(); // Cập nhật sự kiện phân trang
            },
            error: function (xhr) {
                console.log("Lỗi AJAX:", xhr.responseText);
            }
        });
    }

    function updatePaginationEvents() {
        $(".pagination-container a").each(function () {
            var href = $(this).attr("href");
            if (href && href.startsWith("javascript:filterRooms")) {
                $(this).attr("href", "#"); // Xóa link mặc định
                $(this).off("click").on("click", function (e) {
                    e.preventDefault();
                    eval(href); // Chạy lại AJAX khi bấm phân trang
                });
            }
        });
    }

    $(document).ready(function () {
        updatePaginationEvents();
    });

    function getCurrentFilters(page) {
        var filterData = {
            roomTypeId: $(".filter-btn.selected").data("value") || "",
            sortByPrice: $(".filter-btn[data-fil='price']").hasClass("selected") ? "asc" : "",
            dateRange: $("#dateRange").val(),
            page: page || 1
        };
        return filterData;
    }
</script>   


<style>
    
    .navbar-custom2 {
        background: linear-gradient(to right, #f9c5d1, #fef4f4) !important;
        border-bottom: 2px solid #f8a5c2 !important;
        border-radius: 10px;
        padding: 10px;
    }

        .navbar-custom2 .nav-link {
            color: #b2225f !important;
            font-weight: 500;
            border-radius: 20px;
            padding: 10px 20px;
            transition: 0.3s ease;
        }

            /* Hover hiệu ứng chỉ khi nút đã được chọn */
            .navbar-custom2 .nav-link:not(.selected):hover {
                color: inherit !important;
                background-color: transparent !important;
            }

            /* Khi một mục được chọn (active) */
            .navbar-custom2 .nav-link.selected {
                background-color: #ff69b4 !important;
                color: white !important;
                font-weight: bold;
            }
</style>
