@model PagedList.IPagedList<Hotel.Models.RoomDisplay>
@using PagedList.Mvc;


<div class="container mb-3">
    <ul class="nav nav-pills justify-content-center navbar-custom2">
        <li class="nav-item">
            <a class="nav-link filter-khuyenmai selected" href="#">Promotion</a>
        </li>
        <li class="nav-item dropdown">
            <a class="nav-link filter-btn dropdown-toggle" href="#" id="roomTypeDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                Room Types
            </a>
            <ul class="dropdown-menu">
                @foreach (var type in ViewBag.RoomTypes)
                {
                    <li><a class="dropdown-item text-dark bg-white nav-link filter-btn" data-fil="type" href="#" data-value="@type.RoomTypeId">@type.RoomTypeName</a></li>
                }
            </ul>
        </li>
        <li class="nav-item">
            <a class="nav-link filter-btn " data-fil="price" href="#">Price</a>
        </li>
        <li class="nav-item">
            <input type="text" name="dateRange" id="dateRange" class="nav-link form-control" placeholder="Check in - Check out">
            <button class="nav-link btn btn-primary ">
                <i class="fa fa-search filter-btn " data-fil="date"></i>
            </button>
        </li>
    </ul>
</div>

<div class="container row g-3 KHUYENMAI" id="khuyenmai-section">
    <div class="col-lg-4 col-md-4 col-sm-6 col-xs-12">
        <div class="card border-0">
            <div class="card-header bg-transparent text-black ">
                <p><strong>[TẾT 2025] ƯU ĐÃI GIẢM GIÁ LÊN ĐẾN 70%</strong></p>
            </div>
            <div class="card-body bg-transparent text-black">
                <img src="~/Content/images/KM_1.jpg" width="375" height="200" />
            </div>
            <div class="card-footer bg-transparent">
                <p>Thời gian: 01/01/2025 - 30/03/2025</p>
            </div>
        </div>
    </div>

    <div class="col-lg-4 col-md-4 col-sm-6 col-xs-12">
        <div class="card border-0">
            <div class="card-header bg-transparent text-black ">
                <p><strong>[SRING PROMOTION 2025] COMBO NGHỈ DƯỠNG 2N1Đ</strong></p>
            </div>
            <div class="card-body bg-transparent text-black">
                <img src="~/Content/images/KM_2.jpg" width="375" height="200" />
            </div>
            <div class="card-footer bg-transparent">
                <p>Thời gian: 28/02/2025 - 30/04/2025</p>
            </div>
        </div>
    </div>

    <div class="col-lg-4 col-md-4 col-sm-6 col-xs-12">
        <div class="card border-0">
            <div class="card-header bg-transparent text-black ">
                <p><strong>[Mừng Sinh Nhật] GIẢM GIÁ CHO ĐÊM THỨ 2 TẠI KHÁCH SẠN</strong></p>
            </div>
            <div class="card-body bg-transparent text-black">
                <img src="~/Content/images/KM_3.jpg" width="375" height="200" />
            </div>
            <div class="card-footer bg-transparent">
                <p>Thời gian: 10/02/2025 - 20/02/2025</p>
            </div>
        </div>
    </div>
</div>

<!-- Khu vực hiển thị danh sách phòng -->
<div id="room-list">
</div>
<!-- Modal Hiển Thị Chi Tiết Phòng -->
<div class="modal fade" id="roomDetailModal" tabindex="-1" aria-labelledby="roomDetailModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="roomDetailModalLabel">Room Detail</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="roomDetailContent">
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container my-4">
    <div class="card p-4 shadow-lg bg-white rounded">

        @foreach (var item in Model)
        {
            <div class="card mb-4 border-0 shadow-sm">
                <div class="row g-0">
                    <div class="col-md-5">
                        <img class="img-fluid h-100 w-100"
                             src="@Url.Action("GetRoomImage", "Room", new { roomId = item.ID })"
                             alt="Room Image"
                             style="object-fit: cover; height: 100%;">
                    </div>
                    <div class="col-md-7">
                        <div class="card-body d-flex flex-column justify-content-between h-100">
                            <div class="d-flex justify-content-between">

                                <div>
                                    <h4 class="fw-bold mb-1">@item.RoomName</h4>
                                    <div class="text-muted mb-2" style="font-size: 0.95rem;">
                                        @item.Capacity @(item.Capacity > 1 ? "people" : "person") · @item.Description
                                    </div>
                                </div>

                                <div class="text-end">
                                    <div style="font-size: 1.3rem;" class="fw-bold text-dark">
                                        @if (item.Percent > 0)
                                        {
                                            <span>@((item.Price - (item.Price * ((decimal)item.Percent / 100m))).ToString("N0"))</span> <span class="text-uppercase" style="font-size: 0.9rem;">VND</span>
                                            <div class="text-muted" style="font-size: 0.9rem;">
                                                <del>@item.Price.ToString("N0")</del> VND
                                            </div>
                                        }
                                        else
                                        {
                                            <span>@item.Price.ToString("N0")</span> <span class="text-uppercase" style="font-size: 0.9rem;">VND</span>
                                        }
                                        <div style="font-size: 0.85rem;" class="text-muted">/ night</div>
                                    </div>
                                </div>
                            </div>

                            <div class="text-end mt-3">
                                <a href="@Url.Action("Details", "Room", new { id = item.ID })" class="btn btn-dark px-4 py-2 rounded-pill">
                                    Select
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        @if (Model.PageCount > 1)
        {
            <div class="pagination-container text-center mt-3">
                <div class="page-info mb-2">
                    Page @(Model.PageCount < Model.PageNumber ? 0 : Model.PageNumber) / @Model.PageCount
                </div>
                <div class="Menu">
                    @Html.PagedListPager(Model, page => "javascript:filterRooms(getCurrentFilters(" + page + "))", PagedListRenderOptions.Classic)
                </div>
            </div>
        }

    </div>
</div>


<script>
    // Script xử lý lọc theo loại phòng
    $(document).on("click", ".filter-btn[data-fil='type']", function () {
        var roomTypeId = $(this).data("value");
        filterRooms({ roomTypeId: roomTypeId, page: 1 });
    });

    // Script xử lý lọc theo giá (mặc định tăng dần)
    $(document).on("click", ".filter-btn[data-fil='price']", function () {
        filterRooms({ sortByPrice: "asc", page: 1 });
    });

    // Script xử lý lọc theo ngày nhận/trả phòng
    $(document).on("click", ".filter-btn[data-fil='date']", function () {
        var dateRange = $("#dateRange").val();
        filterRooms({ dateRange: dateRange, page: 1 });
    });

    function filterRooms(filterData) {
        $.ajax({
            url: "/Room/FilterRooms",
            type: "GET",
            data: filterData,
            success: function (response) {
                $("#room-list").html(response);
            },
            error: function (xhr, status, error) {
                console.log("Lỗi AJAX:", xhr.responseText);
                alert("Lỗi: " + xhr.responseText);
            }
        });
    }


</script>

<script>
    //lọc script
    $(document).ready(function () {
        $(".filter-btn").click(function (e) {
            e.preventDefault(); // Ngăn chặn load lại trang

            let filter = $(this).data("filter");

            // Ẩn khu vực khuyến mãi khi chọn filter khác
            $("#khuyenmai-section").hide();

            // Xóa class "selected" khỏi tất cả, rồi thêm vào phần tử được bấm
            $(".navbar-custom2 .nav-link").removeClass("selected");
            $(this).addClass("selected");
        });

        // Khi ấn vào "Khuyến mãi", hiển thị lại phần KHUYENMAI
        $(".filter-khuyenmai").click(function (e) {
            e.preventDefault();

            // Hiển thị lại phần khuyến mãi
            $("#khuyenmai-section").show();

            // Xóa class "selected" khỏi tất cả, rồi thêm vào Khuyến mãi
            $(".navbar-custom2 .nav-link").removeClass("selected");
            $(this).addClass("selected");

            // Xóa danh sách phòng
            $("#room-list").html("");
        });
    });
</script>

<script>
    function filterRooms(filterData) {
        $.ajax({
            url: "/Room/FilterRooms",
            type: "GET",
            data: filterData,
            success: function (response) {
                $("#room-list").html(response); // Load lại danh sách phòng
                updatePaginationEvents(); // Cập nhật sự kiện phân trang
            },
            error: function (xhr) {
                console.log("Lỗi AJAX:", xhr.responseText);
            }
        });
    }
    function updatePaginationEvents() {
        $(".pagination-container a").each(function () {
            var href = $(this).attr("href");
            if (href && href.startsWith("javascript:filterRooms")) {
                $(this).attr("href", "#"); // Xóa link mặc định
                $(this).off("click").on("click", function (e) {
                    e.preventDefault();
                    eval(href); // Chạy lại AJAX khi bấm phân trang
                });
            }
        });
    }

    $(document).ready(function () {
        updatePaginationEvents();
    });

    function getCurrentFilters(page) {
        var filterData = {
            roomTypeId: $(".filter-btn.selected").data("value") || "",
            sortByPrice: $(".filter-btn[data-fil='price']").hasClass("selected") ? "asc" : "",
            dateRange: $("#dateRange").val(),
            page: page || 1
        };
        return filterData;
    }
</script>
<script>
    $(document).ready(function () {
        $(document).on("click", ".room-img", function () {
            var roomid = $(this).data("roomid");

            $.get("/Room/GetRoomDetail", { roomid: roomid }, function (data) {
                $("#roomDetailContent").html(data); // Load Partial View vào modal
                $("#roomDetailModal").modal("show"); // Hiển thị modal
            });
        });
    });
</script>
<script>
    updatePaginationEvents();
</script>
<style>
    .room-img {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .room-img:hover {
            transform: scale(1.05);
            box-shadow: 0px 8px 15px rgba(0, 0, 0, 0.2);
        }

    .discount-ribbon {
        position: absolute;
        top: 5px;
        left: -5px;
        background: red;
        color: white;
        padding: 5px 12px;
        font-size: 12px;
        font-weight: bold;
        transform: rotate(-15deg);
        box-shadow: 0 2px 5px rgba(0, 0, 0, 0.2);
    }

    .text-danger {
        font-weight: bold;
        color: red;
    }

    .old-price {
        font-size: 0.8em;
        color: gray;
        margin-right: 5px;
    }

    .card-title {
        font-size: 1.2rem;
        font-weight: bold;
    }

    .badge {
        font-size: 0.9rem;
    }

    .img-fluid {
        border-radius: 5px 0 0 5px;
    }

    .card {
        border-radius: 12px;
    }

    .btn-dark {
        background-color: #000;
        border: none;
    }

        .btn-dark:hover {
            background-color: #333;
        }

    .rounded-pill {
        border-radius: 50px;
    }

    .fw-bold {
        font-weight: 600;
    }
</style>