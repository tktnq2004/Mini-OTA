@model List<Hotel.Models.RoomImage>

@if (Model != null && Model.Any())
{
    var first = Model.First();

    <div class="d-flex" style="height: 100vh; overflow: hidden;">

       <div style="flex: 7; height: 100vh; position: relative;">
           <div id="viewer360" style="width: 100%; height: 100%;"></div>

           <button type="button"
                   id="closeViewerBtn"
                   class="btn btn-danger btn-sm"
                   aria-label="Close"
                   data-bs-dismiss="modal"
                   style="position: absolute; top: 10px; right: 10px; z-index: 9999; border-radius: 6px; padding: 4px 10px; font-size: 20px;">
           </button>
       </div>

        <div style="flex: 3; height: 100vh; overflow-y: auto; padding: 10px; background: transparent;">
            @for (int i = 0; i < Model.Count; i++)
            {
                var img = Model[i];
                <img src="@img.ImageURL"
                     data-img="@img.ImageURL"
                     data-sceneid="scene_@i"
                     class="thumb-360 d-block"
                     style="width: 100%; height: auto; object-fit: cover; margin-bottom: 8px; cursor: pointer;" />
            }
        </div>
    </div>

    <script>
        let viewer;
        $(function () {
            viewer = pannellum.viewer('viewer360', {
                default: {
                    firstScene: 'scene_0',
                    autoLoad: true
                },
                scenes: {
                    @for (int i = 0; i < Model.Count; i++)
                    {
                        var img = Model[i];
                        <text>
                        "scene_@i": {
                            type: "equirectangular",
                            panorama: "@img.ImageURL"
                        }@((i < Model.Count - 1) ? "," : "")
                        </text>
                    }
                }
            });

            $(".thumb-360").click(function () {
                const sceneId = $(this).data("sceneid");
                viewer.loadScene(sceneId);
            });
        });
    </script>
}
else
{
    <p class="text-muted text-center">Không có ảnh 360 nào cho phòng này.</p>
}

<style>
    .thumb-360 {
        border: none;
        background: transparent;
        transition: transform 0.2s;
    }

        .thumb-360:hover {
            transform: scale(1.05);
            box-shadow: none;
        }

    .pnlm-load-box,
    .pnlm-loading {
        display: none !important;
    }
</style>
