@model List<Hotel.Models.RoomImage>

@if (Model != null && Model.Any())
{
    var first = Model.First();

    <!-- Viewer 360 -->
    <div id="viewer360" style="width: 100%; height: 500px; border: 1px solid #ddd;"></div>

    <!-- Danh sách ảnh thu nhỏ -->
    <div class="mt-3 d-flex flex-wrap justify-content-center">
        @foreach (var img in Model)
        {
            <img src="@img.ImageURL"
                 data-img="@img.ImageURL"
                 class="img-thumbnail m-1 thumb-360"
                 style="width: 100px; height: 70px; cursor: pointer;" />
        }
    </div>
        <script>
            let viewer;

            function initPannellum(imageUrl) {
                viewer = pannellum.viewer('viewer360', {
                    type: 'equirectangular',
                    panorama: imageUrl,
                    autoLoad: true,
                    showZoomCtrl: true
                });
            }

            $(document).ready(function () {
                const firstImage = '@first.ImageURL';
                initPannellum(firstImage);

                $(".thumb-360").click(function () {
                    const url = $(this).data("img");
                    viewer.loadScene(viewer.addScene('custom', {
                        type: 'equirectangular',
                        panorama: url,
                        autoLoad: true
                    }));
                });
            });
        </script>
    }
}
else
{
    <p class="text-muted text-center">Không có ảnh 360 nào cho phòng này.</p>
}

<!-- Style -->
<style>
    .thumb-360 {
        border-radius: 8px;
        transition: transform 0.2s;
    }

        .thumb-360:hover {
            transform: scale(1.05);
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.15);
        }

    #viewer360:empty {
        background: #f8f8f8;
        min-height: 500px;
    }
</style>
