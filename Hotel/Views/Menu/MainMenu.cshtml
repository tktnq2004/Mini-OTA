@{
    ViewBag.Title = "MainMenu";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Hotale - Book Your Vacation</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600&family=Open+Sans:wght@400;600&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Dancing+Script&display=swap" rel="stylesheet">

    <style>
        * {
            box-sizing: border-box;
        }

        html, body {
            margin: 0;
            padding: 0;
            overflow-x: hidden;
            font-family: 'Open Sans', sans-serif;
            background: #fff;
            color: #333;
        }

        .booking-section {
            position: relative;
            height: 100vh;
            background: url('/Content/images/logo1/background.jpg') no-repeat center center/cover;
            display: flex;
            justify-content: center;
            align-items: center;
            color: #fff;
            text-align: center;
            padding: 20px;
        }

        .booking-overlay {
            background: rgba(0, 0, 0, 0.5);
            padding: 40px;
            border-radius: 10px;
        }

        .booking-section h1 {
            font-family: 'Dancing Script', cursive;
            font-size: 3em;
            margin-bottom: 10px;
        }

        .booking-section p {
            font-size: 1.2em;
            margin-bottom: 20px;
        }

        .booking-form {
            display: flex;
            gap: 10px;
            justify-content: center;
            flex-wrap: wrap;
        }

        .form-group {
            display: flex;
            flex-direction: column;
            background: #fff;
            padding: 10px;
            border-radius: 5px;
            color: #333;
        }

            .form-group label {
                font-size: 0.9em;
                margin-bottom: 5px;
            }

            .form-group input,
            .form-group select {
                border: none;
                padding: 8px;
                border-radius: 3px;
                width: 150px;
            }

        .book-btn {
            padding: 10px 20px;
            background-color: #fff;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            color: #333;
            font-weight: bold;
        }

            .book-btn:hover {
                background-color: #ddd;
            }

        h2 {
            font-family: 'Playfair Display', serif;
            font-size: 36px;
            text-align: center;
            margin-bottom: 40px;
            position: relative;
        }

            h2::after {
                content: "";
                display: block;
                width: 60px;
                height: 3px;
                background: #000;
                margin: 20px auto 0;
            }

        .hotel-section {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            align-items: center;
            padding: 80px 40px;
            gap: 40px;
        }

        .hotel-text {
            max-width: 500px;
            flex: 1;
        }

        .hotel-info {
            display: flex;
            justify-content: center;
            gap: 40px;
            text-transform: uppercase;
            font-size: 12px;
            letter-spacing: 2px;
            margin-bottom: 20px;
        }

        .hotel-desc {
            font-size: 22px;
            line-height: 1.6;
            margin-bottom: 30px;
        }

        .read-more {
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 1px;
            text-decoration: none;
            color: #000;
            border-bottom: 1px solid #000;
            padding-bottom: 3px;
        }

        .hotel-image {
            max-width: 400px;
            flex: 1;
        }

            .hotel-image img {
                width: 100%;
                border-radius: 20px;
                object-fit: cover;
            }

        .section-title .subtitle {
            font-family: 'Dancing Script', cursive;
            font-size: 36px;
            font-weight: 600;
            margin-bottom: 10px;
        }

        .rooms {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 30px;
        }

        .room-card {
            background: #fafafa;
            border-radius: 8px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
            overflow: hidden;
            width: 300px;
            text-align: center;
            transition: transform 0.3s ease;
        }

            .room-card:hover {
                transform: translateY(-5px);
            }

            .room-card img {
                width: 100%;
                height: 200px;
                object-fit: cover;
            }

        .room-card-body {
            padding: 20px;
        }

        .facilities {
            padding: 80px 20px;
            background: #fff;
        }

        .row {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 30px;
        }

        .facilities-item {
            width: 150px;
            text-align: center;
        }

            .facilities-item img {
                width: 60px;
                height: 60px;
                margin-bottom: 15px;
            }

        .video-section {
            padding: 80px 20px;
        }

            .video-section iframe {
                display: block;
                margin: 0 auto;
                border-radius: 8px;
                max-width: 100%;
            }

        .service {
            padding: 80px 20px;
        }

        .service-wrap__item {
            margin-bottom: 60px;
        }

        .service-item-flex {
            display: flex;
            flex-wrap: wrap;
            gap: 30px;
            align-items: center;
            justify-content: center;
        }

        .service-image, .service-desc {
            flex: 1;
            min-width: 300px;
        }

            .service-image img {
                width: 100%;
                height: auto;
                border-radius: 10px;
                object-fit: cover;
                box-shadow: 0 5px 20px rgba(0, 0, 0, 0.1);
            }

        .service-title {
            font-size: 20px;
            font-weight: bold;
            color: #002060;
            margin-bottom: 15px;
        }

        .desc span {
            color: #898989;
            line-height: 1.6;
            font-size: 15px;
        }

        .link-detail {
            display: inline-block;
            margin-top: 15px;
            color: #002060;
            font-weight: 500;
            text-transform: uppercase;
            font-size: 13px;
            letter-spacing: 0.5px;
            text-decoration: none;
            transition: 0.3s ease;
        }

            .link-detail:hover {
                color: #0056b3;
            }
    </style>
</head>

<body>

    <!-- Booking -->
    <section class="booking-section">
        <div class="booking-overlay">
            <h1>Book Your Vacation</h1>
            <p>Explore new experiences with Hotale</p>
            <form class="booking-form">
                <div class="form-group">
                    <label>Check In</label>
                    <input type="date" id="checkin" value="2025-07-16" />
                </div>
                <div class="form-group">
                    <label>Check Out</label>
                    <input type="date" id="checkout" value="2025-07-17" />
                </div>
                <div class="form-group">
                    <label>Adults</label>
                    <select id="adults">
                        <option>1</option>
                        <option>2</option>
                        <option>3</option>
                    </select>
                </div>
                <div class="form-group">
                    <label>Child</label>
                    <select id="children">
                        <option>0</option>
                        <option>1</option>
                        <option>2</option>
                    </select>
                </div>
                <button type="submit" class="book-btn">Book Rooms</button>
            </form>
        </div>
    </section>

    <!-- About -->
    <section class="hotel-section">
        <div class="hotel-text">
            <div class="hotel-info">
                <div>5 Stars</div>
                <div>25 Rooms</div>
            </div>
            <div class="hotel-desc">
                Our hotel is located in the heart of the New Forrest. A five stars lifestyle surrounded by the forest.
            </div>
            <a href="#" class="read-more">More About Us ></a>
        </div>
        <div class="hotel-image">
            <img src="/Content/images/logo1/resort-swim.jpg" alt="Hotel" />
        </div>
    </section>

    <!-- Rooms -->
    <section>
        <div class="section-title">
            <h2 class="subtitle">Owl Rooms</h2>
        </div>
        <div class="rooms">
            <div class="room-card">
                <img src="https://via.placeholder.com/300x200" />
                <div class="room-card-body">
                    <h4>Deluxe City View</h4>
                    <p>2 Guests | 1 Bed | 1 Bath</p>
                </div>
            </div>
            <div class="room-card">
                <img src="https://via.placeholder.com/300x200" />
                <div class="room-card-body">
                    <h4>Service Dr City View</h4>
                    <p>2 Guests | 1 Bed | 1 Bath</p>
                </div>
            </div>
            <div class="room-card">
                <img src="https://via.placeholder.com/300x200" />
                <div class="room-card-body">
                    <h4>Balcony Triple Suite</h4>
                    <p>3 Guests | 2 Bed | 2 Bath</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Facilities -->
    <section class="facilities">
        <h2>Hotel Facilities</h2>
        <div class="row">
            <div class="facilities-item">
                <img src="/Content/images/logo1/paking.png">
                <h3>Parking</h3>
            </div>
            <div class="facilities-item">
                <img src="/Content/images/logo1/be-boi.png">
                <h3>Swimming Pool</h3>
            </div>
            <div class="facilities-item">
                <img src="/Content/images/logo1/an-sansg.png">
                <h3>Breakfast</h3>
            </div>
            <div class="facilities-item">
                <img src="/Content/images/logo1/gym.png">
                <h3>Gym</h3>
            </div>
            <div class="facilities-item">
                <img src="/Content/images/logo1/spa.png">
                <h3>Spa</h3>
            </div>
            <div class="facilities-item">
                <img src="/Content/images/logo1/wifi.png">
                <h3>WiFi</h3>
            </div>
        </div>
    </section>

    <!-- Video -->
    <section class="video-section">
        <h2>Hotel Video</h2>
        <iframe width="100%" height="500" src="https://www.youtube.com/embed/US7bGTUkBfg" frameborder="0"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen></iframe>
    </section>

    <!-- Services -->
    <section class="service">
        <div class="section-title">
            <h2 class="subtitle">Visit Our Famous Facilities</h2>
        </div>

        <div class="service-wrap__item">
            <div class="service-item-flex">
                <div class="service-image">
                    <img src="/Content/images/logo1/chef-cook.jpg" alt="Restaurant" />
                </div>
                <div class="service-desc">
                    <h3 class="service-title">Restaurant</h3>
                    <span>Flexible banquet hall system for weddings and conferences.</span>
                    <a class="link-detail" href="#">Learn more ></a>
                </div>
            </div>
        </div>

        <div class="service-wrap__item">
            <div class="service-item-flex">
                <div class="service-image">
                    <img src="/Content/images/logo1/bar.jpg" alt="Sky Bar" />
                </div>
                <div class="service-desc">
                    <h3 class="service-title">Sky Bar</h3>
                    <span>Perfect for cocktails, teas, and coffees.</span>
                    <a class="link-detail" href="#">Learn more ></a>
                </div>
            </div>
        </div>

        <div class="service-wrap__item">
            <div class="service-item-flex">
                <div class="service-image">
                    <img src="/Content/images/logo1/spa.jpg" alt="Spa Hotale" />
                </div>
                <div class="service-desc">
                    <h3 class="service-title">Spa Hotale</h3>
                    <span>Enjoy luxurious spa experiences amidst nature.</span>
                    <a class="link-detail" href="#">Learn more ></a>
                </div>
            </div>
        </div>
    </section>

</body>
</html>
