@{
    ViewBag.Title = "MainMenu";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Hotale - Book Your Vacation</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600&family=Open+Sans:wght@400;600&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Dancing+Script&display=swap" rel="stylesheet">

    <style>
        * {
            box-sizing: border-box;
        }

        html, body {
            margin: 0;
            padding: 0;
            overflow-x: hidden;
            font-family: 'Open Sans', sans-serif;
            background: #fff;
            color: #333;
        }

        .booking-section {
            position: relative;
            height: 100vh;
            background: url('/Content/images/logo1/background.jpg') no-repeat center center/cover;
            display: flex;
            justify-content: center;
            align-items: center;
            color: #fff;
            text-align: center;
            padding: 20px;
        }

        .booking-overlay {
            background: rgba(0, 0, 0, 0.5);
            padding: 40px;
            border-radius: 10px;
        }

        .booking-section h1 {
            font-family: 'Dancing Script', cursive;
            font-size: 3em;
            margin-bottom: 10px;
        }

        .booking-section p {
            font-size: 1.2em;
            margin-bottom: 20px;
        }

        .booking-form {
            display: flex;
            gap: 10px;
            justify-content: center;
            flex-wrap: wrap;
        }

        .form-group {
            display: flex;
            flex-direction: column;
            background: #fff;
            padding: 10px;
            border-radius: 5px;
            color: #333;
        }

            .form-group label {
                font-size: 0.9em;
                margin-bottom: 5px;
            }

            .form-group input,
            .form-group select {
                border: none;
                padding: 8px;
                border-radius: 3px;
                width: 150px;
            }

        .book-btn {
            padding: 10px 20px;
            background-color: #fff;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            color: #333;
            font-weight: bold;
        }

            .book-btn:hover {
                background-color: #ddd;
            }

        h2 {
            font-family: 'Playfair Display', serif;
            font-size: 36px;
            text-align: center;
            margin-bottom: 40px;
            position: relative;
        }

            h2::after {
                content: "";
                display: block;
                width: 60px;
                height: 3px;
                background: #000;
                margin: 20px auto 0;
            }

        .hotel-section {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            align-items: center;
            padding: 80px 40px;
            gap: 40px;
        }

        .hotel-text {
            max-width: 500px;
            flex: 1;
        }

        .hotel-info {
            display: flex;
            justify-content: center;
            gap: 40px;
            text-transform: uppercase;
            font-size: 12px;
            letter-spacing: 2px;
            margin-bottom: 20px;
        }

        .hotel-desc {
            font-size: 22px;
            line-height: 1.6;
            margin-bottom: 30px;
        }

        .read-more {
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 1px;
            text-decoration: none;
            color: #000;
            border-bottom: 1px solid #000;
            padding-bottom: 3px;
        }

        .hotel-image {
            max-width: 400px;
            flex: 1;
        }

            .hotel-image img {
                width: 100%;
                border-radius: 20px;
                object-fit: cover;
            }
        .service {
            padding: 80px 20px;
            max-width: 1200px;
            margin: auto;
        }
        .section-title .subtitle {
            font-family: 'Dancing Script', cursive;
            font-size: 36px;
            font-weight: 600;
            margin-bottom: 10px;
        }

        .rooms {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 30px;
        }

        .room-card {
            background: #fafafa;
            border-radius: 8px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
            overflow: hidden;
            width: 300px;
            text-align: center;
            transition: transform 0.3s ease;
        }

            .room-card:hover {
                transform: translateY(-5px);
            }

            .room-card img {
                width: 100%;
                height: 200px;
                object-fit: cover;
            }

        .room-card-body {
            padding: 20px;
        }

        .facilities {
            padding: 80px 20px;
            background: #fff;
        }

        .row {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 30px;
        }

        .facilities-item {
            width: 150px;
            text-align: center;
        }

            .facilities-item img {
                width: 60px;
                height: 60px;
                margin-bottom: 15px;
            }

        .video-section {
            padding: 80px 20px;
        }

            .video-section iframe {
                display: block;
                margin: 0 auto;
                border-radius: 8px;
                max-width: 100%;
            }

        .service-grid {
            display: flex;
            flex-direction: column;
            gap: 60px;
        }

        .service-item {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 40px;
            align-items: center;
        }

            .service-item:nth-child(even) {
                direction: rtl;
            }

                .service-item:nth-child(even) .service-text {
                    direction: ltr;
                }

        .service-img img {
            width: 100%;
            border-radius: 12px;
            object-fit: cover;
            box-shadow: 0 8px 30px rgba(0, 0, 0, 0.1);
        }

        .service-title {
            font-size: 22px;
            font-weight: bold;
            color: #002060;
            margin-bottom: 15px;
        }

        .service-desc {
            font-size: 16px;
            line-height: 1.6;
            color: #555;
            margin-bottom: 15px;
        }

        .desc span {
            color: #898989;
            line-height: 1.6;
            font-size: 15px;
        }

        .link-detail {
            display: inline-block;
            margin-top: 15px;
            color: #002060;
            font-weight: 500;
            text-transform: uppercase;
            font-size: 13px;
            letter-spacing: 0.5px;
            text-decoration: none;
            transition: 0.3s ease;
        }

            .link-detail:hover {
                color: #0056b3;
            }
    </style>
</head>

<body>

    <!-- Booking -->
    <section class="booking-section">
        <div class="booking-overlay">
            <h1>Book Your Vacation</h1>
            <p>Explore new experiences with Hotale</p>
            <form class="booking-form" method="get" action="/Hotel/HotelIndexFromMenu">
                <div class="form-group">
                    <label>Check In</label>
                    <input type="date" id="checkin" name="checkin" />
                </div>
                <div class="form-group">
                    <label>Check Out</label>
                    <input type="date" id="checkout" name="checkout" />
                </div>

                <div class="form-group">
                    <label>Adults</label>
                    <div class="d-flex align-items-center">
                        <button type="button" class="btn btn-outline-secondary btn-sm me-2" onclick="changeGuest('adults', -1)">−</button>
                        <input type="text" id="adults" name="adults" class="text-center form-control form-control-sm" value="1" readonly />
                        <button type="button" class="btn btn-outline-secondary btn-sm ms-2" onclick="changeGuest('adults', 1)">+</button>
                    </div>
                </div>

                <div class="form-group">
                    <label>Child</label>
                    <div class="d-flex align-items-center">
                        <button type="button" class="btn btn-outline-secondary btn-sm me-2" onclick="changeGuest('children', -1)">−</button>
                        <input type="text" id="children" name="children" class="text-center form-control form-control-sm" value="0" readonly />
                        <button type="button" class="btn btn-outline-secondary btn-sm ms-2" onclick="changeGuest('children', 1)">+</button>
                    </div>
                </div>
                <button type="submit" class="book-btn">Book Rooms</button>
            </form>
        </div>
    </section>

    <!-- About -->
    <section class="hotel-section">
        <div class="hotel-text">
            <div class="hotel-info">
                <div>5 Stars</div>
                <div>25 Rooms</div>
            </div>
            <div class="hotel-desc">
                Our hotel is located in the heart of the New Forrest. A five stars lifestyle surrounded by the forest.
            </div>
            <a href="#" class="read-more">More About Us ></a>
        </div>
        <div class="hotel-image">
            <img src="/Content/images/logo1/resort-swim.jpg" alt="Hotel" />
        </div>
    </section>

    <!-- Rooms -->
    <section>
        <div class="section-title">
            <h2 class="subtitle">Owl Rooms</h2>
        </div>
        <div class="rooms">
            <div class="room-card">
                <img src="https://via.placeholder.com/300x200" />
                <div class="room-card-body">
                    <h4>Deluxe City View</h4>
                    <p>2 Guests | 1 Bed | 1 Bath</p>
                </div>
            </div>
            <div class="room-card">
                <img src="https://via.placeholder.com/300x200" />
                <div class="room-card-body">
                    <h4>Service Dr City View</h4>
                    <p>2 Guests | 1 Bed | 1 Bath</p>
                </div>
            </div>
            <div class="room-card">
                <img src="https://via.placeholder.com/300x200" />
                <div class="room-card-body">
                    <h4>Balcony Triple Suite</h4>
                    <p>3 Guests | 2 Bed | 2 Bath</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Facilities -->
    <section class="facilities">
        <h2>Hotel Facilities</h2>
        <div class="row">
            <div class="facilities-item">
                <img src="/Content/images/logo1/paking.png">
                <h3>Parking</h3>
            </div>
            <div class="facilities-item">
                <img src="/Content/images/logo1/be-boi.png">
                <h3>Swimming Pool</h3>
            </div>
            <div class="facilities-item">
                <img src="/Content/images/logo1/an-sansg.png">
                <h3>Breakfast</h3>
            </div>
            <div class="facilities-item">
                <img src="/Content/images/logo1/gym.png">
                <h3>Gym</h3>
            </div>
            <div class="facilities-item">
                <img src="/Content/images/logo1/spa.png">
                <h3>Spa</h3>
            </div>
            <div class="facilities-item">
                <img src="/Content/images/logo1/wifi.png">
                <h3>WiFi</h3>
            </div>
        </div>
    </section>

    <!-- Video -->
    <section class="video-section">
        <h2>Hotel Video</h2>
        <iframe width="100%" height="500" src="https://www.youtube.com/embed/US7bGTUkBfg" frameborder="0"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen></iframe>
    </section>

    <!-- Services -->
    <section class="service">
        <div class="sub-title">
            <h2 style="font-family: 'Dancing Script', cursive; font-size: 32px; font-weight: bold;">
                Visit Our Famous Facilities
            </h2>
        </div>

        <div class="service-grid">
            <!-- Restaurant -->
            <div class="service-item">
                <div class="service-img">
                    <img src="/Content/images/logo1/chef-cook.jpg" alt="Restaurant">
                </div>
                <div class="service-text">
                    <h3 class="service-title">Restaurant</h3>
                    <p class="service-desc">The large, flexible banquet hall system, invested with modern equipment, will always be a great suggestion for high-class weddings and conferences.</p>
                    <a href="/services/2145/restaurant" class="link-detail">Learn more &gt;</a>
                </div>
            </div>

            <!-- Sky Bar -->
            <div class="service-item">
                <div class="service-img">
                    <img src="/Content/images/logo1/bar.jpg" alt="Sky Bar">
                </div>
                <div class="service-text">
                    <h3 class="service-title">Sky Bar</h3>
                    <p class="service-desc">Celebrate your moment with one of our highlights for cocktails or if you prefer, a selection of international teas and locally sourced coffees are available hot or refreshingly iced.</p>
                    <a href="/services/2146/sky-bar" class="link-detail">Learn more &gt;</a>
                </div>
            </div>

            <!-- Spa Hotale -->
            <div class="service-item">
                <div class="service-img">
                    <img src="/Content/images/logo1/spa.jpg" alt="Spa Hotale">
                </div>
                <div class="service-text">
                    <h3 class="service-title">Spa Hotale</h3>
                    <p class="service-desc">Get lost in the luxurious and charming Spa Hotale Hotel oasis to enjoy moments of absolute relaxation in the midst of nature. Here, you can immerse yourself in unique spa experiences.</p>
                    <a href="/services/2147/spa-hotale" class="link-detail">Learn more &gt;</a>
                </div>
            </div>
        </div>
    </section>

</body>
</html>

<script>
    const today = new Date();
    const tomorrow = new Date();
    tomorrow.setDate(today.getDate() + 1);

    // Format YYYY-MM-DD
    const formatDate = (d) => {
        const year = d.getFullYear();
        const month = String(d.getMonth() + 1).padStart(2, '0');
        const day = String(d.getDate()).padStart(2, '0');
        return `${year}-${month}-${day}`;
    };

    document.getElementById("checkin").value = formatDate(today);
    document.getElementById("checkout").value = formatDate(tomorrow);
</script>
<script>
    function changeGuest(id, delta) {
        const adultsInput = document.getElementById("adults");
        const childrenInput = document.getElementById("children");

        let adults = parseInt(adultsInput.value);
        let children = parseInt(childrenInput.value);

        if (id === "adults") {
            const newAdults = Math.max(1, Math.min(adults + delta, 5));
            const total = newAdults + children;
            if (total <= 5) {
                adultsInput.value = newAdults;
            }
        } else if (id === "children") {
            const newChildren = Math.max(0, Math.min(children + delta, 5));
            const total = adults + newChildren;
            if (total <= 5) {
                childrenInput.value = newChildren;
            }
        }
    }
</script>
